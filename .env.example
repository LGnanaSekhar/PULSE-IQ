# Set these in Render; no local database setup is needed.
DATABASE_URL=postgresql://ROLE:PASSWORD@NEON_POOLED_HOST/neondb?sslmode=require
APP_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
BOOTSTRAP_ADMIN_PASSWORD=CHOOSE_A_STRONG_PASSWORD_AT_LEAST_12_CHARACTERS
SEED_DEMO=true
DEMO_STUDENTS=1000
COOKIE_SECURE=true
SOURCE_KIND=none
# Optional read-only institutional connector, configured later:
# SOURCE_KIND=sql
# SOURCE_NAME=College authorized database
# SOURCE_DATABASE_URL=postgresql+psycopg://READ_ONLY_ROLE:PASSWORD@COLLEGE_HOST/college?sslmode=require
# SOURCE_MAPPING=connectors/mapping.json
# SOURCE_KIND=mongodb
# SOURCE_MONGODB_URI=mongodb+srv://READ_ONLY_ROLE:PASSWORD@CLUSTER_HOST/
# SOURCE_MONGODB_DATABASE=college
# SOURCE_KIND=api
# SOURCE_API_URL=https://COLLEGE_API_HOST/pulseiq/canonical-records
# SOURCE_API_TOKEN=ONLY_IF_THE_INSTITUTION_API_REQUIRES_IT
